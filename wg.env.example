# Example /etc/govpn/wg.env. The installer writes its own copy; this file is
# for reading the available settings. Values here assume a Debian/Ubuntu host.

# REST API listen address. Keep it on loopback and use an SSH tunnel or a
# reverse proxy with TLS; the API itself speaks plain HTTP.
# One or more comma-separated IPv4 HOST:PORT (no 0.0.0.0), e.g.
# 127.0.0.1:8080,172.18.0.1:8080 for a UI on a Docker bridge network.
GOVPN_LISTEN=127.0.0.1:8080

# Persistent state (JSON, mode 0600). Contains every private and preshared key.
GOVPN_DATA_DIR=/var/lib/govpn/wg

# debug | info | warn | error
GOVPN_LOG_LEVEL=info

# Single admin account. Generate the hash with:
#   printf '%s\n' 'your-password' | govpn-wg hash-password
GOVPN_ADMIN_USER=admin
GOVPN_ADMIN_PASSWORD_HASH='$2a$10$replace-with-a-real-bcrypt-hash'

# Access token lifetime, 5m..168h.
GOVPN_TOKEN_TTL=12h

# Public IP or hostname written into peer configs. Empty = detected from the
# default route at runtime.
GOVPN_ENDPOINT=
# Pin the public interface instead of detecting it. Empty = auto.
GOVPN_PUBLIC_IF=

# First WireGuard UDP port; additional interfaces get the next free port.
GOVPN_BASE_PORT=3478
GOVPN_DEFAULT_MTU=1360
# DNS pushed to clients. In split mode a resolver is only emitted when it is
# inside AllowedIPs, so a public resolver never takes over the client machine.
GOVPN_DNS=1.1.1.1
GOVPN_KEEPALIVE=25

# Networks behind the hub that sites/clients may be granted.
GOVPN_SERVER_LAN=
# Masquerade tunnel traffic into the server LAN so no return route is needed.
GOVPN_LAN_NAT=1

# mtu = clamp TCP MSS to MTU-40, pmtu = --clamp-mss-to-pmtu
GOVPN_MSS_MODE=mtu

# Kernel tuning at startup/install. IPv4 only: IPv6 forwarding is left alone.
GOVPN_TUNE_ON_START=1
GOVPN_TUNE_NIC=1
# max | <rx>,<tx>
GOVPN_NIC_RING=max
# Extra sysctl entries, separated by ';'
GOVPN_SYSCTL_EXTRA=
